rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function house(hid) { return get(/databases/$(database)/documents/houses/$(hid)); }
    function owner(hid) { return signedIn() && house(hid).data.ownerUid == request.auth.uid; }
    function member(hid) { return signedIn() && request.auth.uid in house(hid).data.memberIds; }
    match /profiles/{uid} {
      allow get: if signedIn() && request.auth.uid == uid;
      allow list: if false;
      allow create, update: if signedIn() && request.auth.uid == uid
        && request.resource.data.keys().hasOnly(['displayName','phone','updatedAt'])
        && request.resource.data.displayName is string
        && request.resource.data.displayName.size() > 0
        && request.resource.data.displayName.size() <= 40
        && request.resource.data.phone is string
        && request.resource.data.phone.size() <= 16
        && request.resource.data.updatedAt == request.time;
      allow delete: if false;
    }
    match /houses/{hid} {
      function validMemberChange() {
        let before = resource.data.memberIds;
        let after = request.resource.data.memberIds;
        let added = after.removeAll(before);
        return (added.size() == 0 && after.hasAny([resource.data.ownerUid]) && after.size() <= before.size())
          || (added.size() == 1 && after.size() == before.size() + 1
              && after.hasAll(before)
              && exists(/databases/$(database)/documents/houses/$(hid)/joinRequests/$(added[0]))
              && getAfter(/databases/$(database)/documents/houses/$(hid)/joinRequests/$(added[0])).data.status == 'accepted');
      }
      allow create: if signedIn()
        && hid.matches('[a-f0-9]{32}')
        && request.resource.data.keys().hasOnly(['name','ownerUid','memberIds','createdAt'])
        && request.resource.data.name is string
        && request.resource.data.name.size() > 0 && request.resource.data.name.size() <= 25
        && request.resource.data.ownerUid == request.auth.uid
        && request.resource.data.memberIds == [request.auth.uid]
        && request.resource.data.createdAt == request.time;
      allow get, list: if signedIn() && request.auth.uid in resource.data.memberIds;
      allow update: if signedIn() && resource.data.ownerUid == request.auth.uid
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['name','memberIds'])
        && request.resource.data.ownerUid == resource.data.ownerUid
        && request.resource.data.createdAt == resource.data.createdAt
        && request.resource.data.name is string
        && request.resource.data.name.size() > 0 && request.resource.data.name.size() <= 25
        && request.resource.data.memberIds is list
        && request.resource.data.memberIds.size() <= 30
        && validMemberChange()
        && request.auth.uid in request.resource.data.memberIds;
      allow delete: if false;
      match /memberSettings/{uid} {
        allow get, list: if member(hid);
        allow create, update: if owner(hid)
          && uid != request.auth.uid
          && uid in house(hid).data.memberIds
          && request.resource.data.keys().hasOnly(['displayName','role','suspendedUntil','updatedAt'])
          && request.resource.data.displayName is string
          && request.resource.data.displayName.size() <= 60
          && request.resource.data.role in ['user','authorized']
          && (request.resource.data.suspendedUntil == null ||
             (request.resource.data.suspendedUntil is timestamp &&
              request.resource.data.suspendedUntil > request.time &&
              request.resource.data.suspendedUntil < request.time + duration.value(365, 'd')))
          && request.resource.data.updatedAt == request.time;
        allow delete: if false;
      }
      match /bookingRequests/{requestId} {
        function validRequest() {
          return request.resource.data.keys().hasOnly(['createdBy','displayName','startAt','endAt','note','status','createdAt'])
            && request.resource.data.createdBy == request.auth.uid
            && request.resource.data.displayName is string
            && request.resource.data.displayName.size() <= 60
            && request.resource.data.note is string
            && request.resource.data.note.size() <= 200
            && request.resource.data.status == 'pending'
            && request.resource.data.startAt is timestamp
            && request.resource.data.endAt is timestamp
            && request.resource.data.startAt > request.time
            && request.resource.data.endAt > request.resource.data.startAt
            && request.resource.data.endAt < request.resource.data.startAt + duration.value(30, 'd')
            && request.resource.data.createdAt == request.time;
        }
        function notSuspended() {
          return !exists(/databases/$(database)/documents/houses/$(hid)/memberSettings/$(request.auth.uid))
            || get(/databases/$(database)/documents/houses/$(hid)/memberSettings/$(request.auth.uid)).data.suspendedUntil == null
            || get(/databases/$(database)/documents/houses/$(hid)/memberSettings/$(request.auth.uid)).data.suspendedUntil <= request.time;
        }
        allow create: if signedIn() && member(hid) && notSuspended() && validRequest();
        allow get, list: if signedIn() && (owner(hid) || (member(hid) && resource.data.createdBy == request.auth.uid));
        allow update: if signedIn() && member(hid)
          && resource.data.createdBy == request.auth.uid
          && resource.data.status == 'pending'
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status'])
          && request.resource.data.status == 'cancelled';
        allow delete: if false;
      }
      match /joinRequests/{uid} {
        allow create: if signedIn() && uid == request.auth.uid
          && exists(/databases/$(database)/documents/houses/$(hid))
          && !member(hid)
          && request.resource.data.keys().hasOnly(['uid','displayName','status','createdAt'])
          && request.resource.data.uid == uid
          && request.resource.data.displayName is string
          && request.resource.data.displayName.size() <= 60
          && request.resource.data.status == 'pending'
          && request.resource.data.createdAt == request.time;
        allow get, list: if signedIn() && (uid == request.auth.uid || owner(hid));
        allow update: if owner(hid)
          && resource.data.status == 'pending'
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status'])
          && request.resource.data.status in ['accepted','rejected']
          && (request.resource.data.status == 'rejected' || uid in getAfter(/databases/$(database)/documents/houses/$(hid)).data.memberIds);
        allow delete: if false;
      }
    }
    match /{document=**} { allow read, write: if false; }
  }
}