rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function house(hid) { return get(/databases/$(database)/documents/houses/$(hid)); }
    function owner(hid) { return signedIn() && house(hid).data.ownerUid == request.auth.uid; }
    function member(hid) { return signedIn() && request.auth.uid in house(hid).data.memberIds; }
    function activeHouse(hid) { return member(hid) && (!('deletedAt' in house(hid).data) || house(hid).data.deletedAt == null); }
    function instantAllowed(hid) { return owner(hid) || (activeHouse(hid) && exists(/databases/$(database)/documents/houses/$(hid)/memberSettings/$(request.auth.uid)) && get(/databases/$(database)/documents/houses/$(hid)/memberSettings/$(request.auth.uid)).data.canTakeCar == true && (get(/databases/$(database)/documents/houses/$(hid)/memberSettings/$(request.auth.uid)).data.suspendedUntil == null || get(/databases/$(database)/documents/houses/$(hid)/memberSettings/$(request.auth.uid)).data.suspendedUntil <= request.time)); }
    match /profiles/{uid} {
      allow get: if signedIn() && request.auth.uid == uid;
      allow list: if false;
      allow create, update: if signedIn() && request.auth.uid == uid
        && request.resource.data.keys().hasOnly(['displayName','phone','updatedAt'])
        && request.resource.data.displayName is string
        && request.resource.data.displayName.size() > 0
        && request.resource.data.displayName.size() <= 40
        && request.resource.data.phone is string
        && request.resource.data.phone.size() <= 16
        && request.resource.data.updatedAt == request.time;
      allow delete: if false;
    }
    match /houses/{hid} {
      function validMemberChange() {
        let before = resource.data.memberIds;
        let after = request.resource.data.memberIds;
        let added = after.removeAll(before);
        return (added.size() == 0 && after.hasAny([resource.data.ownerUid]) && after.size() <= before.size())
          || (added.size() == 1 && after.size() == before.size() + 1
              && after.hasAll(before)
              && exists(/databases/$(database)/documents/houses/$(hid)/joinRequests/$(added[0]))
              && getAfter(/databases/$(database)/documents/houses/$(hid)/joinRequests/$(added[0])).data.status == 'accepted');
      }
      allow create: if signedIn()
        && hid.matches('[a-f0-9]{32}')
        && request.resource.data.keys().hasOnly(['name','ownerUid','memberIds','createdAt'])
        && request.resource.data.name is string
        && request.resource.data.name.size() > 0 && request.resource.data.name.size() <= 25
        && request.resource.data.ownerUid == request.auth.uid
        && request.resource.data.memberIds == [request.auth.uid]
        && request.resource.data.createdAt == request.time;
      allow get, list: if signedIn() && request.auth.uid in resource.data.memberIds;
      allow update: if signedIn() && resource.data.ownerUid == request.auth.uid
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['name','memberIds','deletedAt'])
        && request.resource.data.ownerUid == resource.data.ownerUid
        && request.resource.data.createdAt == resource.data.createdAt
        && request.resource.data.name is string
        && request.resource.data.name.size() > 0 && request.resource.data.name.size() <= 25
        && request.resource.data.memberIds is list
        && request.resource.data.memberIds.size() <= 30
        && (!('deletedAt' in request.resource.data) || request.resource.data.deletedAt == null || (request.resource.data.deletedAt is timestamp && (request.resource.data.deletedAt == request.time || (resource.data.get('deletedAt', null) is timestamp && request.resource.data.deletedAt == resource.data.deletedAt))))
        && (request.resource.data.get('deletedAt', null) == resource.data.get('deletedAt', null) || (request.resource.data.deletedAt == request.time && resource.data.get('deletedAt', null) == null) || (request.resource.data.deletedAt == null && resource.data.get('deletedAt', null) is timestamp && resource.data.deletedAt + duration.value(7, 'd') > request.time))
        && validMemberChange()
        && request.auth.uid in request.resource.data.memberIds;
      allow delete: if false;
      match /memberSettings/{uid} {
        allow get, list: if member(hid);
        allow create, update: if owner(hid)
          && uid != request.auth.uid
          && uid in getAfter(/databases/$(database)/documents/houses/$(hid)).data.memberIds
          && request.resource.data.keys().hasOnly(['displayName','role','canTakeCar','suspendedUntil','updatedAt'])
          && request.resource.data.get('canTakeCar', false) is bool
          && request.resource.data.displayName is string
          && request.resource.data.displayName.size() <= 60
          && request.resource.data.role in ['user','authorized']
          && (request.resource.data.suspendedUntil == null ||
             (request.resource.data.suspendedUntil is timestamp &&
              request.resource.data.suspendedUntil > request.time &&
              request.resource.data.suspendedUntil < request.time + duration.value(365, 'd')))
          && request.resource.data.updatedAt == request.time;
        allow delete: if false;
      }
      match /system/{docId} {
        function reservationApproved(item) {
          return item.keys().hasOnly(['id','createdBy','startAt','endAt'])
            && item.createdBy == request.auth.uid
            && getAfter(/databases/$(database)/documents/houses/$(hid)/bookingRequests/$(item.id)).data.createdBy == request.auth.uid
            && getAfter(/databases/$(database)/documents/houses/$(hid)/bookingRequests/$(item.id)).data.status == 'approved'
            && getAfter(/databases/$(database)/documents/houses/$(hid)/bookingRequests/$(item.id)).data.startAt == item.startAt
            && getAfter(/databases/$(database)/documents/houses/$(hid)/bookingRequests/$(item.id)).data.endAt == item.endAt;
        }
        function reservationEnded(item) {
          return item.createdBy == request.auth.uid
            && getAfter(/databases/$(database)/documents/houses/$(hid)/bookingRequests/$(item.id)).data.status == 'ended';
        }
        function instantCreate() {
          return instantAllowed(hid)
            && request.resource.data.reservations.size() == 1
            && reservationApproved(request.resource.data.reservations[0]);
        }
        function instantUpdate() {
          let added = request.resource.data.reservations.removeAll(resource.data.reservations);
          let removed = resource.data.reservations.removeAll(request.resource.data.reservations);
          return instantAllowed(hid)
            && (
              (added.size() == 1 && removed.size() == 0 && reservationApproved(added[0]))
              || (added.size() == 0 && removed.size() == 1 && reservationEnded(removed[0]))
            );
        }
        allow get: if docId == 'schedule' && member(hid);
        allow list: if false;
        allow create: if docId == 'schedule'
          && request.resource.data.keys().hasOnly(['reservations','updatedAt'])
          && request.resource.data.reservations is list
          && request.resource.data.reservations.size() <= 80
          && request.resource.data.updatedAt == request.time
          && (owner(hid) || instantCreate());
        allow update: if docId == 'schedule'
          && request.resource.data.keys().hasOnly(['reservations','updatedAt'])
          && request.resource.data.reservations is list
          && request.resource.data.reservations.size() <= 80
          && request.resource.data.updatedAt == request.time
          && (owner(hid) || instantUpdate());
        allow delete: if false;
      }
      match /bookingRequests/{requestId} {
        function validRequest() {
          return request.resource.data.keys().hasOnly(['createdBy','displayName','startAt','endAt','note','status','createdAt'])
            && request.resource.data.createdBy == request.auth.uid
            && request.resource.data.displayName is string
            && request.resource.data.displayName.size() > 0
            && request.resource.data.displayName.size() <= 60
            && request.resource.data.note is string
            && request.resource.data.note.size() <= 200
            && request.resource.data.status == 'pending'
            && request.resource.data.startAt is timestamp
            && request.resource.data.endAt is timestamp
            && request.resource.data.startAt > request.time
            && request.resource.data.endAt > request.resource.data.startAt
            && request.resource.data.endAt <= request.resource.data.startAt + duration.value(30, 'd')
            && request.resource.data.createdAt == request.time;
        }
        function notSuspended() {
          return !exists(/databases/$(database)/documents/houses/$(hid)/memberSettings/$(request.auth.uid))
            || get(/databases/$(database)/documents/houses/$(hid)/memberSettings/$(request.auth.uid)).data.suspendedUntil == null
            || get(/databases/$(database)/documents/houses/$(hid)/memberSettings/$(request.auth.uid)).data.suspendedUntil <= request.time;
        }
        function ownerDecision() {
          return owner(hid)
            && resource.data.status == 'pending'
            && (
              (request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status'])
                && request.resource.data.status == 'rejected')
              ||
              (request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status','approvedBy','approvedAt'])
                && request.resource.data.status == 'approved'
                && request.resource.data.approvedBy == request.auth.uid
                && request.resource.data.approvedAt == request.time
                && getAfter(/databases/$(database)/documents/houses/$(hid)/system/schedule).data.reservations.hasAny([{
                  'id': requestId,
                  'createdBy': resource.data.createdBy,
                  'startAt': resource.data.startAt,
                  'endAt': resource.data.endAt
                }]))
            );
        }
        function ownerCancellation() {
          return owner(hid) && resource.data.status == 'approved'
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status'])
            && request.resource.data.status == 'cancelled';
        }
        function validInstant() {
          return instantAllowed(hid)
            && request.resource.data.keys().hasOnly(['createdBy','displayName','startAt','endAt','note','status','createdAt','instantMode'])
            && request.resource.data.createdBy == request.auth.uid
            && request.resource.data.displayName is string
            && request.resource.data.displayName.size() > 0 && request.resource.data.displayName.size() <= 60
            && request.resource.data.note is string && request.resource.data.note.size() <= 200
            && request.resource.data.instantMode in ['fixed','untilDone']
            && request.resource.data.status == 'approved'
            && request.resource.data.startAt is timestamp && request.resource.data.endAt is timestamp
            && request.resource.data.startAt >= request.time - duration.value(2,'m')
            && request.resource.data.startAt <= request.time + duration.value(20,'m')
            && request.resource.data.endAt > request.resource.data.startAt
            && request.resource.data.endAt <= request.resource.data.startAt + duration.value(30,'d')
            && request.resource.data.createdAt == request.time
            && getAfter(/databases/$(database)/documents/houses/$(hid)/system/schedule).data.reservations.hasAny([{
              'id': requestId, 'createdBy': request.auth.uid,
              'startAt': request.resource.data.startAt, 'endAt': request.resource.data.endAt
            }]);
        }
        function finishInstant() {
          return activeHouse(hid)
            && resource.data.status == 'approved'
            && (resource.data.createdBy == request.auth.uid || owner(hid))
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status','endedAt'])
            && request.resource.data.status == 'ended'
            && request.resource.data.endedAt == request.time
            && !getAfter(/databases/$(database)/documents/houses/$(hid)/system/schedule).data.reservations.hasAny([{
              'id': requestId, 'createdBy': resource.data.createdBy,
              'startAt': resource.data.startAt, 'endAt': resource.data.endAt
            }]);
        }
        allow create: if (activeHouse(hid) && notSuspended() && validRequest()) || validInstant();
        // All household members can view requests so the shared calendar and status are consistent.
        allow get, list: if member(hid);
        allow update: if (
          member(hid) && resource.data.createdBy == request.auth.uid
          && resource.data.status == 'pending'
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status'])
          && request.resource.data.status == 'cancelled'
        ) || ownerDecision() || ownerCancellation() || finishInstant();
        allow delete: if false;
      }
      match /joinRequests/{uid} {
        allow create: if signedIn() && uid == request.auth.uid
          && exists(/databases/$(database)/documents/houses/$(hid))
          && !member(hid)
          && request.resource.data.keys().hasOnly(['uid','displayName','status','createdAt'])
          && request.resource.data.uid == uid
          && request.resource.data.displayName is string
          && request.resource.data.displayName.size() <= 60
          && request.resource.data.status == 'pending'
          && request.resource.data.createdAt == request.time;
        allow get, list: if signedIn() && (uid == request.auth.uid || owner(hid));
        allow update: if (
          owner(hid)
          && resource.data.status == 'pending'
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status'])
          && request.resource.data.status in ['accepted','rejected']
          && (request.resource.data.status == 'rejected' || uid in getAfter(/databases/$(database)/documents/houses/$(hid)).data.memberIds)
        ) || (
          signedIn() && uid == request.auth.uid && !member(hid)
          && resource.data.status in ['rejected','accepted']
          && request.resource.data.keys().hasOnly(['uid','displayName','status','createdAt'])
          && request.resource.data.uid == uid
          && request.resource.data.displayName is string
          && request.resource.data.displayName.size() <= 60
          && request.resource.data.status == 'pending'
          && request.resource.data.createdAt == request.time
        );
        allow delete: if false;
      }
    }
    match /{document=**} { allow read, write: if false; }
  }
}